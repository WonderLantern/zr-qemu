+void HELPER(wl_sev)(CPUARMState *env, uint32_t local)
+{
+#ifndef CONFIG_USER_ONLY
+    CPUState *source = env_cpu(env), *target;
+    bool take_lock = !bql_locked();
+    if (take_lock) {
+        bql_lock();
+    }
+    CPU_FOREACH(target) {
+        ARMCPU *cpu = ARM_CPU(target);
+        if (!cpu->wl_event_peer || (local && source != target)) {
+            continue;
+        }
+        if (cpu->env.wl_event_waiting) {
+            /* This event completes the outstanding WFE. EXITTB wakes the
+             * halted CPU without inventing an architectural interrupt. */
+            cpu->env.wl_event_waiting = false;
+            cpu->env.wl_event_pending = false;
+            cpu->env.wl_event_wakes++;
+            cpu_interrupt(target, CPU_INTERRUPT_EXITTB);
+        } else {
+            cpu->env.wl_event_pending = true;
+        }
+    }
+    if (take_lock) {
+        bql_unlock();
+    }
+#endif
+}
+
 void HELPER(wfe)(CPUARMState *env)
 {
+#ifndef CONFIG_USER_ONLY
+    ARMCPU *cpu = env_archcpu(env);
+    if (cpu->wl_event_block && env->aarch64) {
+        CPUState *cs = env_cpu(env);
+        uint32_t excp;
+        int target_el;
+        env->wl_event_waiting = false;
+        if (env->wl_event_pending) {
+            env->wl_event_pending = false;
+            return;
+        }
+        if (cpu_has_work(cs)) {
+            return;
+        }
+        target_el = check_wfx_trap(env, true, &excp);
+        if (target_el) {
+            env->pc -= 4;
+            raise_exception(env, excp, syn_wfx(1, 0xe, 1, false), target_el);
+        }
+        env->wl_event_waiting = true;
+        env->wl_event_sleeps++;
+        cs->exception_index = EXCP_HLT;
+        cs->halted = 1;
+        cpu_loop_exit(cs);
+    }
+#endif
